@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container">
        <div class="hero-grid">
            <div>
                <span class="eyebrow reveal"><span class="dot"></span> 24/7 Emergency Care</span>
                <h1 class="reveal" data-delay="1">
                    Healthcare,<br />
                    <span class="grad">reimagined</span> for you.
                </h1>
                <p class="hero-sub reveal" data-delay="2">
                    Book your appointment with our experienced doctors in under a minute,
                    and keep track of all your upcoming visits in one place.
                </p>
                <div class="hero-ctas reveal" data-delay="3">
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">
                        Make Appointment
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
                    </a>
                    <a asp-controller="Appointments" asp-action="Index" class="btn btn-ghost">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        View Appointments
                    </a>
                </div>
            </div>

            <div class="reveal" data-delay="2">
                <div class="hero-visual">
                    <img src="~/img/slider/1.jpg" alt="Unity Hospital" onerror="this.style.display='none'" />
                    <div style="display:flex;gap:10px;align-items:center;">
                        <div style="width:36px;height:36px;border-radius:10px;background:var(--grad-emerald);display:grid;place-items:center;color:#04060c">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="18"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                        </div>
                        <div>
                            <strong style="color:var(--text);font-size:13px">Live monitoring</strong>
                            <div style="color:var(--text-mute);font-size:11px">96 ICU beds online</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</section>
