@model Appointment

@{
    ViewData["Title"] = "Book Appointment";
}

<section class="page-hero">

    <div class="container">

        <div class="breadcrumb reveal">

            <a asp-controller="Home" asp-action="Index">
                Home
            </a>

            <span>/</span>

            Book Appointment

        </div>

        <h1 class="reveal" data-delay="1">
            Book an <span class="grad">appointment.</span>
        </h1>

        <p class="reveal" data-delay="2">
            Choose your preferred date and time and book your appointment.
        </p>

    </div>

</section>


<section class="section-sm">

    <div class="container" style="max-width:960px">

        <div class="glass reveal" style="padding:40px">

            <form asp-action="Create" method="post">

                <input type="hidden" asp-for="DoctorId" />


                @if (ViewBag.Doctor != null)
                {
                    <div class="form-group">

                        <label>Doctor</label>

                        <input class="form-control"
                               value="@ViewBag.Doctor.Name - @ViewBag.Doctor.Specialization"
                               readonly />

                    </div>
                }


                <div class="form-group">

                    <label asp-for="PatientName">
                        Full name
                    </label>

                    <input asp-for="PatientName"
                           class="form-control"
                           placeholder="Your name"
                           required />

                    <span asp-validation-for="PatientName"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-grid">

                    <div class="form-group">

                        <label asp-for="Date">
                            Preferred date
                        </label>

                        <input asp-for="Date"
                               type="date"
                               class="form-control"
                               required />

                    </div>

                    <div class="form-group">

                        <label asp-for="Time">Time</label>

                        <select asp-for="Time"
                                class="form-control"
                                required>

                            <option value="">Select Time</option>

                            <option value="09:00:00">9:00 AM</option>
                            <option value="09:30:00">9:30 AM</option>
                            <option value="10:00:00">10:00 AM</option>
                            <option value="10:30:00">10:30 AM</option>
                            <option value="11:00:00">11:00 AM</option>
                            <option value="11:30:00">11:30 AM</option>
                            <option value="12:00:00">12:00 PM</option>
                            <option value="12:30:00">12:30 PM</option>
                            <option value="13:00:00">1:00 PM</option>
                            <option value="13:30:00">1:30 PM</option>
                            <option value="14:00:00">2:00 PM</option>
                            <option value="14:30:00">2:30 PM</option>
                            <option value="15:00:00">3:00 PM</option>
                            <option value="15:30:00">3:30 PM</option>
                            <option value="16:00:00">4:00 PM</option>
                            <option value="16:30:00">4:30 PM</option>

                        </select>

                        <span asp-validation-for="Time"
                              class="text-danger">
                        </span>

                    </div>
                  


                </div>


                <p class="text-mute"
                   style="font-size:13px;margin:8px 0 22px">

                    Bookings available 8:00 AM – 10:00 PM.

                </p>


                <button type="submit"
                        class="btn btn-primary"
                        style="width:100%;justify-content:center">

                    Request Appointment

                </button>

            </form>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}