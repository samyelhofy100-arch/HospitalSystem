@model List<Doctor>

@{
    ViewData["Title"] = "Our Doctors";
}

<section class="page-hero">
    <div class="container">

        <div class="breadcrumb reveal">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            Doctors
        </div>

        <h1 class="reveal" data-delay="1">
            Meet our <span class="grad">doctors.</span>
        </h1>

        <p class="reveal" data-delay="2">
            Experienced specialists dedicated to providing the best healthcare.
        </p>

    </div>
</section>


<section class="section-sm">

    <div class="container">

        <!-- Filters -->

        <form asp-controller="Doctors"
              asp-action="Index"
              method="get"
              style="margin-bottom: 30px;">

            <div style="display: flex; gap: 15px; align-items: center;">

                <input type="text"
                       name="name"
                       value="@ViewBag.Name"
                       placeholder="Doctor Name"
                       class="form-control" />

                <input type="text"
                       name="specialization"
                       value="@ViewBag.Specialization"
                       placeholder="Specialization"
                       class="form-control" />

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

                <a asp-controller="Doctors"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Clear
                </a>

            </div>

        </form>


        <!-- Doctors -->

        <div class="doctor-grid">

            @foreach (var doctor in Model)
            {
                <div class="doctor-card reveal">

                    <div class="doctor-image">

                        <img src="~/img/team/@doctor.ImageUrl"
                             alt="@doctor.Name">

                    </div>

                    <div class="doctor-info">

                        <h3>@doctor.Name</h3>

                        <p>@doctor.Specialization</p>

                        <a asp-controller="Appointments"
                           asp-action="Create"
                           asp-route-doctorId="@doctor.Id"
                           class="btn btn-primary">

                            Book Appointment

                        </a>

                    </div>

                </div>
            }

        </div>


        <!-- Pagination -->

        <div class="pagination-container">

            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-controller="Doctors"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-name="@ViewBag.Name"
                   asp-route-specialization="@ViewBag.Specialization"
                   class="btn btn-secondary">

                    Previous

                </a>
            }


            <span style="margin: 0 15px;">

                Page @ViewBag.CurrentPage
                of @ViewBag.TotalPages

            </span>


            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-controller="Doctors"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-name="@ViewBag.Name"
                   asp-route-specialization="@ViewBag.Specialization"
                   class="btn btn-primary">

                    Next

                </a>
            }

        </div>

    </div>

</section>

